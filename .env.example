# ==============================================================================
# NovaCPP Environment Configuration Boilerplate (.env)
# Loaded automatically at startup by np::loadEnv(".env")
# ==============================================================================

# HTTP Port for Web Server (defaults to 8080)
PORT=8080

# SQLite Database Location or URI
# Supports file paths, sqlite://, file://, and :memory:
DATABASE_URL=sqlite://./data/nova.db

# SQLite RAII Connection Pool Size (default: 10)
POOL_SIZE=10

# Session Sliding Expiration in seconds (default: 3600)
SESSION_TTL=3600

# Optional: Distributed Redis Session Store (enables multi-pod scaling)
# Format: redis://[password@]host[:port]
# REDIS_URL=redis://127.0.0.1:6379

# Application Environment Mode (development | production)
APP_ENV=development

